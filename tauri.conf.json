{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Escudo",
  "version": "1.0.0",
  "identifier": "app.escudo.blocker",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Escudo",
        "width": 900,
        "height": 640,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Escudo",
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Bloqueador de anúncios e rastreadores",
    "windows": {
      "wix": {
        "language": "pt-BR",
        "upgradeCode": "3f6b2a1e-8c4d-4e7a-9b5f-2d1c0e9a7b63"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
